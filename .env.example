# AfterHours AI — environment variables
#
# Copy this file to `.env.local` for local development, and set the same names
# in your hosting provider's dashboard for a deployment (on Vercel: Project →
# Settings → Environment Variables).
#
# ─────────────────────────────────────────────────────────────────────────────
# These are SERVER-SIDE ONLY. Never prefix either name with NEXT_PUBLIC_.
#
#   NEXT_PUBLIC_* variables are inlined into the JavaScript bundle and are
#   readable by anyone who opens devtools. Prefixing a key with NEXT_PUBLIC_
#   publishes it. There is deliberately no NEXT_PUBLIC_ variable in this project.
# ─────────────────────────────────────────────────────────────────────────────
#
# Placeholders only in this file. Never commit a real value here.

# Market data (Finnhub). Required — without it the app cannot show a price.
# Free key: https://finnhub.io/register
# Free tier: 60 requests/minute. Read server-side only, in src/lib/market/finnhub.ts.
FINNHUB_API_KEY=

# Analysis model credential (Groq). Optional.
#
# If this is empty the app does not break: it answers with the deterministic
# demo engine and labels the result "Demo analysis" in the UI. The same fallback
# applies if Groq errors, times out, or returns something that fails validation.
#
# Free key: https://console.groq.com/keys
# Read server-side only, in src/lib/ai/provider.ts, and sent to Groq as an
# Authorization header — never as a query parameter.
GROQ_API_KEY=

# Optional. Which model to use for live analysis.
# Defaults to openai/gpt-oss-20b when unset. Any Groq model that supports
# structured outputs will work; see https://console.groq.com/docs/models
AI_MODEL=
